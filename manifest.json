{
  "manifest_version": 2,
  "name": "Guardian Kids",
  "version": "1.0.0",
  "description": "Simple parental control extension to block websites and regulate internet access",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_title": "Guardian Kids Settings"
  },
  "web_accessible_resources": [
    "blocked/blocked.html",
    "blocked/blocked.js"
  ]
}
